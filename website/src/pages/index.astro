---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<!-- Header Navbar -->
	<header class="navbar">
		<div class="navbar-container">
			<a href="#" class="logo">
				<img class="logo-icon" src="/app-icon.svg" alt="Prose Logo" />
				<span class="logo-text">Prose</span>
			</a>
			
			<nav class="nav-links">
				<a href="#features">Features</a>
				<a href="#screenshots">Gallery</a>
				<a href="/privacy">Privacy</a>
				<a href="https://github.com/salernoelia/prose" target="_blank" rel="noopener" class="btn btn-primary btn-sm">GitHub</a>
			</nav>
		</div>
	</header>

	<!-- Hero Section -->
	<section class="hero">
		<div class="hero-content">
			<span class="badge">Local-First eReader</span>
			<h1 class="hero-title">Read peacefully.</h1>
			<p class="hero-subtitle">
				A minimalist, fast, and secure reader for ePub and PDF. Organize your personal library locally and synchronize across devices on your own terms.
			</p>
			<div class="hero-actions">
				<a href="https://github.com/salernoelia/prose" target="_blank" rel="noopener" class="btn btn-primary">Get the App</a>
				<a href="#features" class="btn btn-secondary">Learn More</a>
			</div>
		</div>

		<!-- Compact Hero Phone Mockup -->
		<div class="hero-mockup-wrapper">
			<div class="device-frame hero-device">
				<img src="/screenshots/personal-library-grid.png" alt="Prose Library View" class="device-screen" />
			</div>
		</div>
	</section>

	<!-- Features Grid -->
	<section id="features" class="features-section">
		<div class="section-header">
			<h2 class="section-title">Designed for readers.</h2>
			<p class="section-desc">Every detail is optimized for comfort, distraction-free reading, and absolute control over your library.</p>
		</div>

		<div class="features-grid">
			<div class="feature-card">
				<div class="feature-icon">
					<span class="material-symbols-outlined">shield</span>
				</div>
				<h3>Privacy by Design</h3>
				<p>Your library and reading habits are private. No analytics, tracking, or telemetry. Your books stay strictly on your device.</p>
			</div>

			<div class="feature-card">
				<div class="feature-icon">
					<span class="material-symbols-outlined">database</span>
				</div>
				<h3>Local-First Database</h3>
				<p>Powered by a native SQLite core. Enjoy lightning-fast startup, page turns under 100 ms, and offline access to 1,000+ books.</p>
			</div>

			<div class="feature-card">
				<div class="feature-icon">
					<span class="material-symbols-outlined">cloud_sync</span>
				</div>
				<h3>Private Cloud Sync</h3>
				<p>Synchronize reading positions, highlights, and annotations seamlessly using your own private WebDAV server.</p>
			</div>

			<div class="feature-card">
				<div class="feature-icon">
					<span class="material-symbols-outlined">edit</span>
				</div>
				<h3>Active Annotations</h3>
				<p>Create bookmarks, highlight text, and perform offline dictionary lookups instantly inside the reading interface.</p>
			</div>

			<div class="feature-card">
				<div class="feature-icon">
					<span class="material-symbols-outlined">text_fields</span>
				</div>
				<h3>Custom Typographies</h3>
				<p>Personalize font size, family, margins, and line spacing. Read comfortably using light, dark, or sepia color modes.</p>
			</div>

			<div class="feature-card">
				<div class="feature-icon">
					<span class="material-symbols-outlined">bar_chart</span>
				</div>
				<h3>Detailed Analytics</h3>
				<p>Gain insights into your reading routine. Track pages per minute, daily sessions, and weekly progress charts offline.</p>
			</div>
		</div>
	</section>

	<!-- Screenshots Showcase Gallery -->
	<section id="screenshots" class="screenshots-section">
		<div class="section-header">
			<h2 class="section-title">Interface Showcase</h2>
			<p class="section-desc">Take a visual tour of Prose. Clean layouts, adaptive typography, and structured statistics.</p>
		</div>

		<div class="carousel-container">
			<div class="carousel-track">
				<div class="carousel-item">
					<div class="device-frame">
						<img src="/screenshots/personal-library-grid.png" alt="Personal Library Grid" class="device-screen" />
					</div>
					<p class="carousel-caption">Personal Library Grid</p>
				</div>

				<div class="carousel-item">
					<div class="device-frame">
						<img src="/screenshots/reading-statistics.png" alt="Reading Statistics" class="device-screen" />
					</div>
					<p class="carousel-caption">Reading Statistics</p>
				</div>

				<div class="carousel-item">
					<div class="device-frame">
						<img src="/screenshots/typography-settings.png" alt="Typography Settings" class="device-screen" />
					</div>
					<p class="carousel-caption">Typography Settings</p>
				</div>

				<div class="carousel-item">
					<div class="device-frame">
						<img src="/screenshots/epub-reading-mode.png" alt="ePub Reading Mode" class="device-screen" />
					</div>
					<p class="carousel-caption">ePub Reading Mode</p>
				</div>

				<div class="carousel-item">
					<div class="device-frame">
						<img src="/screenshots/quick-formatting-menu.png" alt="Quick Formatting Menu" class="device-screen" />
					</div>
					<p class="carousel-caption">Quick Formatting Menu</p>
				</div>

				<div class="carousel-item">
					<div class="device-frame">
						<img src="/screenshots/text-selection-and-notes.png" alt="Text Selection and Notes" class="device-screen" />
					</div>
					<p class="carousel-caption">Text Selection & Notes</p>
				</div>

				<div class="carousel-item">
					<div class="device-frame">
						<img src="/screenshots/offline-dictionary-lookup.png" alt="Offline Dictionary Lookup" class="device-screen" />
					</div>
					<p class="carousel-caption">Offline Dictionary Lookup</p>
				</div>

				<div class="carousel-item">
					<div class="device-frame">
						<img src="/screenshots/table-of-contents-sidebar.png" alt="Table of Contents Sidebar" class="device-screen" />
					</div>
					<p class="carousel-caption">Table of Contents Sidebar</p>
				</div>

				<div class="carousel-item">
					<div class="device-frame">
						<img src="/screenshots/bookmarks-and-highlights-list.png" alt="Bookmarks and Highlights List" class="device-screen" />
					</div>
					<p class="carousel-caption">Bookmarks & Highlights List</p>
				</div>

				<div class="carousel-item">
					<div class="device-frame">
						<img src="/screenshots/fixed-layout-pdf-reader.png" alt="Fixed-Layout PDF Reader" class="device-screen" />
					</div>
					<p class="carousel-caption">Fixed-Layout PDF Reader</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Footer -->
	<footer class="footer">
		<div class="footer-container">
			<div class="footer-brand">
				<a href="#" class="logo">
					<img class="logo-icon" src="/app-icon.svg" alt="Prose Logo" />
					<span class="logo-text">Prose</span>
				</a>
				<p>A quiet, local-first reading space for macOS, Windows, and Linux.</p>
			</div>
			
			<div class="footer-links">
				<div class="links-column">
					<h4>Application</h4>
					<a href="#features">Features</a>
					<a href="#screenshots">Gallery</a>
				</div>
				<div class="links-column">
					<h4>Project & Legal</h4>
					<a href="https://github.com/salernoelia/prose" target="_blank" rel="noopener">GitHub</a>
					<a href="/privacy">Privacy Policy</a>
					<a href="mailto:hello@eliasalerno.ch">hello@eliasalerno.ch</a>
				</div>
			</div>
		</div>
		<div class="footer-bottom">
			<p>&copy; 2026 Elia Salerno. All rights reserved.</p>
		</div>
	</footer>
</Layout>

<style>
	/* Navbar */
	.navbar {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		height: 64px;
		background-color: var(--glass-bg);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border-bottom: 1px solid var(--glass-border);
		z-index: 100;
	}

	.navbar-container {
		max-width: 1040px;
		height: 100%;
		margin: 0 auto;
		padding: 0 20px;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.logo {
		display: flex;
		align-items: center;
		gap: 10px;
		text-decoration: none;
	}

	.logo-icon {
		width: 28px;
		height: 28px;
		border-radius: 7px;
	}

	.logo-text {
		font-family: var(--font-serif);
		font-size: 20px;
		font-weight: 600;
		color: var(--text-primary);
		letter-spacing: -0.02em;
	}

	.nav-links {
		display: flex;
		align-items: center;
		gap: 24px;
	}

	.nav-links a {
		font-size: 13px;
		font-weight: 500;
		color: var(--text-muted);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.nav-links a:hover {
		color: var(--text-primary);
	}

	.nav-links .btn {
		margin-left: 6px;
	}

	/* Hero Section */
	.hero {
		max-width: 1040px;
		margin: 0 auto;
		padding: 120px 20px 60px;
		display: grid;
		grid-template-columns: 1.15fr 0.85fr;
		gap: 48px;
		align-items: center;
	}

	.hero-content {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}

	.badge {
		background-color: var(--bg-secondary);
		border: 1px solid var(--border);
		color: var(--accent);
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 0.5px;
		padding: 4px 12px;
		border-radius: 16px;
		margin-bottom: 18px;
		text-transform: uppercase;
	}

	.hero-title {
		font-family: var(--font-serif);
		font-size: 50px;
		line-height: 1.1;
		font-weight: 600;
		margin: 0 0 16px;
		color: var(--text-primary);
		letter-spacing: -0.03em;
	}

	.hero-subtitle {
		font-size: 16px;
		line-height: 1.6;
		color: var(--text-muted);
		margin: 0 0 28px;
		max-width: 460px;
	}

	.hero-actions {
		display: flex;
		gap: 12px;
	}

	/* Sleek, proportional device frames */
	.hero-mockup-wrapper {
		display: flex;
		justify-content: center;
		align-items: center;
	}

	.device-frame {
		width: 210px;
		aspect-ratio: 1284 / 2778;
		border-radius: 28px;
		border: 6px solid #1C1917;
		background-color: #1C1917;
		box-shadow: 0 16px 36px -10px rgba(28, 25, 23, 0.2), 0 1px 3px rgba(28, 25, 23, 0.08);
		overflow: hidden;
		flex-shrink: 0;
	}

	.hero-device {
		width: 230px;
		border-width: 7px;
		border-radius: 32px;
		box-shadow: 0 20px 48px -12px rgba(28, 25, 23, 0.25), 0 1px 4px rgba(28, 25, 23, 0.1);
	}

	.device-screen {
		width: 100%;
		height: 100%;
		display: block;
		object-fit: cover;
	}

	/* Features Grid Section */
	.features-section {
		border-top: 1px solid var(--border);
		max-width: 1040px;
		margin: 0 auto;
		padding: 80px 20px;
	}

	.section-header {
		text-align: center;
		max-width: 560px;
		margin: 0 auto 48px;
	}

	.section-title {
		font-family: var(--font-serif);
		font-size: 32px;
		font-weight: 600;
		margin: 0 0 12px;
		color: var(--text-primary);
		letter-spacing: -0.02em;
	}

	.section-desc {
		font-size: 15px;
		line-height: 1.5;
		color: var(--text-muted);
		margin: 0;
	}

	.features-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 24px;
	}

	.feature-card {
		background-color: var(--bg-card);
		border: 1px solid var(--border);
		padding: 28px;
		border-radius: 14px;
		transition: border-color 0.2s ease, transform 0.2s ease;
		box-shadow: 0 2px 8px rgba(28, 25, 23, 0.03);
	}

	.feature-card:hover {
		border-color: var(--accent);
		transform: translateY(-2px);
	}

	.feature-icon {
		width: 42px;
		height: 42px;
		border-radius: 9px;
		background-color: var(--bg-secondary);
		color: var(--accent);
		display: flex;
		justify-content: center;
		align-items: center;
		margin-bottom: 18px;
	}

	.feature-icon .material-symbols-outlined {
		font-size: 22px;
	}

	.feature-card h3 {
		font-family: var(--font-serif);
		font-size: 18px;
		font-weight: 600;
		margin: 0 0 8px;
		color: var(--text-primary);
	}

	.feature-card p {
		font-size: 13px;
		line-height: 1.55;
		color: var(--text-muted);
		margin: 0;
	}

	/* Screenshots Showcase Carousel */
	.screenshots-section {
		border-top: 1px solid var(--border);
		padding: 80px 0;
		background-color: var(--bg-secondary);
	}

	.carousel-container {
		width: 100%;
		overflow-x: auto;
		padding: 10px 0 40px;
		display: flex;
		scroll-snap-type: x mandatory;
		scrollbar-width: none;
	}

	.carousel-container::-webkit-scrollbar {
		display: none;
	}

	.carousel-track {
		display: flex;
		gap: 28px;
		padding: 0 60px;
	}

	.carousel-item {
		display: flex;
		flex-direction: column;
		align-items: center;
		scroll-snap-align: center;
		flex-shrink: 0;
	}

	.carousel-caption {
		margin-top: 14px;
		font-size: 13px;
		font-weight: 500;
		color: var(--text-muted);
	}

	/* Footer Layout */
	.footer {
		border-top: 1px solid var(--border);
		background-color: var(--bg-primary);
		padding: 60px 20px 32px;
	}

	.footer-container {
		max-width: 1040px;
		margin: 0 auto 48px;
		display: flex;
		justify-content: space-between;
		gap: 48px;
	}

	.footer-brand {
		max-width: 300px;
	}

	.footer-brand p {
		margin-top: 12px;
		font-size: 13px;
		line-height: 1.5;
		color: var(--text-muted);
	}

	.footer-links {
		display: flex;
		gap: 60px;
	}

	.links-column {
		display: flex;
		flex-direction: column;
		gap: 10px;
	}

	.links-column h4 {
		font-size: 12px;
		font-weight: 600;
		color: var(--text-primary);
		text-transform: uppercase;
		letter-spacing: 0.5px;
		margin: 0 0 6px;
	}

	.links-column a {
		font-size: 13px;
		color: var(--text-muted);
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.links-column a:hover {
		color: var(--text-primary);
	}

	.footer-bottom {
		border-top: 1px solid var(--border);
		max-width: 1040px;
		margin: 0 auto;
		padding-top: 24px;
		display: flex;
		justify-content: center;
	}

	.footer-bottom p {
		font-size: 12px;
		color: var(--text-muted);
		margin: 0;
	}

	/* Buttons - White text on orange */
	.btn {
		display: inline-flex;
		justify-content: center;
		align-items: center;
		padding: 10px 22px;
		border-radius: 24px;
		font-size: 13px;
		font-weight: 600;
		text-decoration: none;
		cursor: pointer;
		transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
	}

	.btn-sm {
		padding: 6px 14px;
		font-size: 12px;
		border-radius: 16px;
	}

	.btn-primary {
		background-color: var(--accent);
		color: #ffffff !important;
		border: 1px solid var(--accent);
	}

	.btn-primary:hover {
		background-color: var(--accent-hover);
		border-color: var(--accent-hover);
		color: #ffffff !important;
	}

	.btn-secondary {
		background-color: var(--bg-card);
		color: var(--text-primary);
		border: 1px solid var(--border);
	}

	.btn-secondary:hover {
		background-color: var(--bg-secondary);
		border-color: var(--text-muted);
	}

	/* Responsive */
	@media (max-width: 860px) {
		.hero {
			grid-template-columns: 1fr;
			padding-top: 100px;
			gap: 36px;
			text-align: center;
		}

		.hero-content {
			align-items: center;
		}

		.hero-subtitle {
			margin-left: auto;
			margin-right: auto;
		}

		.features-grid {
			grid-template-columns: repeat(2, 1fr);
		}

		.footer-container {
			flex-direction: column;
			gap: 32px;
		}
	}

	@media (max-width: 580px) {
		.features-grid {
			grid-template-columns: 1fr;
		}

		.nav-links {
			display: none;
		}

		.hero-title {
			font-size: 36px;
		}

		.carousel-track {
			padding: 0 20px;
			gap: 20px;
		}
	}
</style>
