<style is:global>
	:root {
		--bg-primary: #F7EDDA; /* Venetian Lace */
		--bg-secondary: #F7DFBA; /* Macadamia Beige */
		--bg-card: #FDF9F2;
		--bg-dark: #09332C; /* Fence Green */
		--bg-dark-card: #15413A; /* Norfolk Green tint */
		
		--text-primary: #1C1917; /* Deep Ink */
		--text-muted: #6B635B;
		--text-light: #F7EDDA;
		
		--accent: #F0531C; /* Fiery Glow */
		--accent-hover: #D4420F;
		--accent-gold: #FFA74F; /* Pumpkin Vapor */
		
		--border: #E8DCC8;
		--border-dark: #1D4B42;
		--glass-bg: rgba(247, 237, 218, 0.88);
		--glass-border: rgba(232, 220, 200, 0.8);
		
		--font-sans: 'Inter', system-ui, -apple-system, sans-serif;
		--font-serif: 'Literata', 'Lora', Georgia, serif;
	}

	html {
		background-color: var(--bg-primary);
		color: var(--text-primary);
		font-family: var(--font-sans);
		scroll-behavior: smooth;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}

	body {
		margin: 0;
		padding: 0;
		width: 100%;
		min-height: 100%;
		overflow-x: hidden;
		background-color: var(--bg-primary);
	}

	/* 3D Book Cover styling for web mockups */
	.book-cover-3d {
		position: relative;
		border-radius: 4px 7px 7px 4px;
		box-shadow: 2px 4px 14px rgba(28, 25, 23, 0.16), 0 1px 3px rgba(28, 25, 23, 0.08);
		transform-style: preserve-3d;
		overflow: hidden;
	}

	.book-cover-3d::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		bottom: 0;
		width: 12px;
		background: linear-gradient(
			to right,
			rgba(0, 0, 0, 0.28) 0%,
			rgba(0, 0, 0, 0.12) 35%,
			rgba(255, 255, 255, 0.25) 50%,
			rgba(0, 0, 0, 0.1) 70%,
			transparent 100%
		);
		pointer-events: none;
		z-index: 5;
	}

	.drop-cap::first-letter {
		font-size: 3.2em;
		float: left;
		line-height: 0.8;
		padding-right: 0.12em;
		padding-top: 0.08em;
		font-family: var(--font-serif);
		color: var(--accent);
		font-weight: 700;
	}

	/* Simple custom scrollbar */
	::-webkit-scrollbar {
		width: 8px;
		height: 8px;
	}
	::-webkit-scrollbar-track {
		background: var(--bg-primary);
	}
	::-webkit-scrollbar-thumb {
		background: var(--bg-secondary);
		border-radius: 4px;
	}
	::-webkit-scrollbar-thumb:hover {
		background: var(--accent);
	}
</style>

