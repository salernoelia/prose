{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Prose",
    "version": "0.1.0",
    "identifier": "com.elano.prose",
    "build": {
        "beforeDevCommand": "bun run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "bun run build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "Prose",
                "width": 1100,
                "height": 760,
                "minWidth": 480,
                "minHeight": 600
            }
        ],
        "security": {
            "assetProtocol": {
                "enable": true,
                "scope": [
                    "$APPDATA/**/*"
                ]
            },
            "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost https://asset.localhost prose: http://prose.localhost https://prose.localhost data: blob:; font-src 'self' prose: http://prose.localhost https://prose.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' blob:; worker-src 'self' blob:; frame-src 'self' blob: data:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost https://asset.localhost prose: http://prose.localhost https://prose.localhost blob: data:;"
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "iOS": {
            "developmentTeam": "9LKY7MBW4C"
        },
        "fileAssociations": [
            {
                "ext": ["epub"],
                "name": "EPUB Book",
                "role": "Viewer"
            },
            {
                "ext": ["pdf"],
                "name": "PDF Document",
                "role": "Viewer"
            }
        ]
    },
    "plugins": {
        "core": {
            "asset": {
                "scope": [
                    "$APPDATA/**"
                ]
            }
        }
    }
}